{
  "name": "history-mega-app",
  "version": "1.0.0",
  "description": "GCSE History Study & Revision Portal (KS3 & GCSE)",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "sync": "node scripts/ai_heal_headings.cjs && node scripts/extract_units.cjs && node scripts/build_database.cjs && node scripts/verify_asset_paths.cjs && node scripts/generate_all_quiz_packs.cjs && node scripts/generate_pupil_workbooks.cjs && node scripts/generate_mastery_packs.cjs && node scripts/verify_vault_answers.cjs && node scripts/compress_images.cjs && node scripts/generate_source_peel_metadata.cjs && npm run export:pdf",
    "sync:unit": "node scripts/sync_unit.cjs",
    "build-unit": "node scripts/build_unit.cjs",
    "create-unit": "node scripts/create_unit.js",
    "test:content": "node scripts/test_content.mjs && node scripts/verify_vault_answers.cjs",
    "verify:facts": "node scripts/verify_curriculum_facts.cjs",
    "verify:vault": "node scripts/verify_vault_answers.cjs",
    "verify:vocab": "node scripts/verify_vocab_parity.cjs",
    "test:sync": "node scripts/test_question_sync.cjs",
    "test:qa": "node scripts/test_question_sync.cjs && node scripts/verify_vault_answers.cjs && node scripts/check_vault_randomization.cjs && node scripts/verify_source_sync.cjs && node scripts/verify_source_lettering.cjs && node scripts/verify_source_act_alignment.cjs && node scripts/verify_images.cjs && node scripts/verify_sanitization.cjs && npm run audit:clutter && npm run check:budget",
    "audit:clutter": "node scripts/audit_page_budget.cjs --clutter-only",
    "check:budget": "node scripts/check_overflows.cjs public/units/great_war/pupil_workbook.html --strict && node scripts/check_overflows.cjs public/units/early_modern_world/pupil_workbook.html --strict && node scripts/check_overflows.cjs public/units/medieval_england/pupil_workbook.html --strict && node scripts/check_overflows.cjs public/units/industrialisation_and_empire/pupil_workbook.html --strict",
    "audit:roadmap": "node scripts/audit_curriculum_roadmap.cjs",
    "verify:sanitization": "node scripts/verify_sanitization.cjs",
    "audit:pedagogy": "node scripts/audit_pedagogy_standards.cjs",
    "verify:sources": "node scripts/verify_source_sync.cjs",
    "verify:lettering": "node scripts/verify_source_lettering.cjs",
    "verify:alignment": "node scripts/verify_source_act_alignment.cjs",
    "export:pdf": "node scripts/export_pdfs.cjs && node scripts/generate_scheme_of_work.cjs",
    "balance:textbook": "node scripts/auto_balance_textbook.cjs",
    "balance:textbook:all": "node scripts/auto_balance_textbook.cjs all",
    "audit:textbook": "node scripts/audit_textbook_pages.cjs",
    "cover:standalone": "node scripts/generate_all_standalone_cover_packs.cjs",
    "cover:email": "python scripts/generate_cover_email.py",
    "booklet:yr7": "node scripts/generate_water_sanitation_quiz_booklet.cjs",
    "booklet:yr8": "node scripts/generate_early_modern_quiz_booklet.cjs",
    "booklet:yr9": "node scripts/generate_great_war_quiz_booklet.cjs",
    "booklet:all": "node scripts/generate_water_sanitation_quiz_booklet.cjs && node scripts/generate_early_modern_quiz_booklet.cjs && node scripts/generate_great_war_quiz_booklet.cjs",
    "sync:curriculum": "node scripts/sync_curriculum_documents.cjs",
    "sync:drive": "node scripts/sync_admin_pdfs_to_drive.cjs",
    "check:randomization": "node scripts/check_vault_randomization.cjs",
    "clean:cache": "node scripts/clean_cache.cjs",
    "clean:check": "node scripts/clean_cache.cjs --check",
    "clean:temp": "node scripts/clean_cache.cjs",
    "clean:schedule": "powershell -ExecutionPolicy Bypass -File scripts/register_scheduled_cleanup.ps1",
    "generate:boosters": "node scripts/generate_overdue_revision_sheets.cjs",
    "prepare": "husky"
  },
  "keywords": [
    "education",
    "history",
    "sso"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@netlify/blobs": "^11.1.0",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "jsdom": "^29.1.1",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "docx": "^9.7.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "prettier": "^3.9.6",
    "puppeteer": "^25.9.0",
    "vite": "^8.0.14"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,css,html}": [
      "prettier --write"
    ]
  }
}
